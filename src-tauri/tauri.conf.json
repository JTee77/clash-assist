{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Egress Checker",
  "version": "0.1.16",
  "identifier": "com.egresschecker.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Egress Checker",
        "width": 1350,
        "height": 880,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 452 },
        "appPosition": { "x": 165, "y": 170 },
        "applicationFolderPosition": { "x": 495, "y": 170 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
