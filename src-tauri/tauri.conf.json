{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash Assist",
  "version": "0.2.0",
  "identifier": "com.clashassist.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Clash伴侣",
        "width": 1350,
        "height": 880,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 540,
          "height": 360
        },
        "appPosition": {
          "x": 140,
          "y": 135
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 135
        }
      },
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
